{
  "name": "krav-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Live-visning av Gherkin-kravene i krav/",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:oppgaver": "vite --open --mode oppgaver",
    "build": "tsc --noEmit && vite build",
    "test": "node --test core/*.test.ts server/*.test.ts shared/*.test.ts src/*.test.ts",
    "vscode:install": "mkdir -p ~/.vscode/extensions && ln -sfn \"$PWD/vscode\" ~/.vscode/extensions/sikt.krav-viewer-sync-1.0.0",
    "app:dev": "electron-vite dev",
    "app:build": "electron-vite build",
    "app:dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "fuse.js": "^7.5.0",
    "isomorphic-git": "^1.42.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "main": "./out/main/index.js"
}
